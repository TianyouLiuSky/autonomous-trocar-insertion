# Source in every terminal AFTER selecting a newly initialized session.
# export ISMR_SESSION=lab_YYYYMMDD_toolID
export ISMR_MODE=calibration
# Source the laboratory's ROS/catkin setup before launching, or set:
# export ROS_SETUP=.../setup.bash
# export CATKIN_SETUP=.../setup.bash
# All artifact defaults resolve inside data/sessions/$ISMR_SESSION.
export TIP_MODEL=rcmoffset
export MIC_RCM_MODE=circle
export MIC_CIRCLE_D405_MODEL=fixed
export MIC_ROS_LIVE=0
export BIPLANAR_MODE=1
